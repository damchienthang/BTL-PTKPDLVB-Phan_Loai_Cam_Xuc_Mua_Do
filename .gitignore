# ==========================================
# Python & Môi trường ảo
# ==========================================
.venv/
env/
venv/
ENV/
__pycache__/
*.py[cod]
*$py.class

# ==========================================
# Cấu hình bảo mật & Token API
# ==========================================
.env
*.env

# ==========================================
# Tệp hệ thống & IDE
# ==========================================
.DS_Store
Thumbs.db
.idea/
.vscode/
*.suo
*.user

# ==========================================
# Tệp nhị phân và khóa tạm của Microsoft Office
# ==========================================
*.exe
tools/*.exe
~$*.xlsx
~$*.xls
~$*.docx

# ==========================================
# Báo cáo đánh giá cá nhân / Tệp rác
# ==========================================
Đánh giá*.docx
*.pdf
archive/
output_llm_test/
simple_post_excel/
du_lieu_*.xlsx
checkpoint_*.json

# Dữ liệu bảng tính và text data ở thư mục gốc nếu có
*.xlsx
*.xls
*.csv

# ==========================================
# TOÀN BỘ DỮ LIỆU TRONG THƯ MỤC DATA
# Giữ lại cây thư mục trống bằng .gitkeep
# ==========================================
data/**
!data/**/
!data/**/.gitkeep

# Thư mục tools: bỏ qua exe nhị phân nặng, dữ liệu crawl tạm, theo dõi script python và .gitkeep
tools/*.exe
tools/data/**
!tools/*.py
!tools/**/
!tools/**/.gitkeep
